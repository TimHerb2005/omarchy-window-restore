#!/usr/bin/env python3
# hypr-restore-settings: SUPER+D
# Omarchy menu to configure Window Restore settings.
# Also used by the Window Restore Quickshell plugin: each `menu_*` function
# below is a thin wrapper that asks the Omarchy menu for a value, then hands
# it to an `apply_*` function that actually performs the change. The CLI
# subcommands (see cli_main) call the same `apply_*` functions directly with
# a value the plugin already collected in its own UI, so both front ends
# share one source of truth for what a setting change does.

import datetime, json, os, subprocess, sys

HISTORY_FILE = os.path.expanduser("~/.cache/hypr-window-history.json")
HIDDEN_FILE  = os.path.expanduser("~/.cache/hypr-restore-hidden.json")
MODE_FILE    = os.path.expanduser("~/.cache/hypr-restore-mode")
CONFIG_FILE  = os.path.expanduser("~/.cache/hypr-restore-config.json")

DEFAULT_EXCLUDED = ["org.omarchy.btop"]


def notify(color, msg, config=None):
    if config is None:
        config = get_config()
    if not config.get("notifications_enabled", True):
        return
    subprocess.run(["notify-send", "-t", "3000", "Window Restore", msg])


def get_mode():
    try:
        with open(MODE_FILE) as f: return f.read().strip()
    except: return "relaunch"


def set_mode(mode):
    os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
    with open(MODE_FILE, "w") as f: f.write(mode)


def get_config():
    try:
        with open(CONFIG_FILE) as f: return json.load(f)
    except: return {"max_windows": 5, "excluded_classes": list(DEFAULT_EXCLUDED), "notifications_enabled": True}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as f: json.dump(cfg, f, indent=2)


def pick(items, placeholder):
    """Show the Omarchy menu with predefined options."""
    result = subprocess.run(
        ["omarchy-menu-select", placeholder + "…", *items],
        capture_output=True, text=True)
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def input_text(placeholder):
    """Show the Omarchy menu's freeform text input."""
    result = subprocess.run(
        ["omarchy-menu-input", placeholder + "…"],
        capture_output=True, text=True)
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def load_json(path):
    try:
        with open(path) as f: return json.load(f)
    except: return []


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f: json.dump(data, f)


def trim_history(n):
    """Truncate relaunch history to n entries."""
    h = load_json(HISTORY_FILE)
    if len(h) > n:
        save_json(HISTORY_FILE, h[:n])


def trim_hidden(n):
    """Truncate hidden list to n entries, killing the excess windows."""
    hidden = load_json(HIDDEN_FILE)
    if len(hidden) > n:
        to_kill = hidden[n:]
        for entry in to_kill:
            addr = entry.get("address", "")
            if addr:
                subprocess.run(["hyprctl", "dispatch", f"hl.dsp.window.close({{ window = 'address:{addr}' }})"])
        save_json(HIDDEN_FILE, hidden[:n])


def kill_all_hidden():
    """Kill all processes currently hidden on workspace 99 and clear the hidden list."""
    hidden = load_json(HIDDEN_FILE)
    killed = 0
    for entry in hidden:
        addr = entry.get("address", "")
        if addr:
            subprocess.run(["hyprctl", "dispatch", f"hl.dsp.window.close({{ window = 'address:{addr}' }})"])
            killed += 1
    save_json(HIDDEN_FILE, [])
    return killed


def apply_mode(new_mode, current_mode):
    if new_mode == current_mode:
        return
    if new_mode == "relaunch":
        # Kill all hidden windows before switching — their state can't be used in relaunch mode
        killed = kill_all_hidden()
        set_mode("relaunch")
        msg = f"󰑓  Mode: RELAUNCH  ({killed} hidden window{'s' if killed != 1 else ''} closed)" if killed else "󰑓  Mode: RELAUNCH"
        notify("8be9fd", msg)
    elif new_mode == "hide":
        set_mode("hide")
        notify("bd93f9", "󰈉  Mode: HIDE – state is preserved")


def menu_mode(mode):
    new_mode = pick([
        "󰑓  Relaunch – app restarts fresh (default)" + ("  ✓" if mode == "relaunch" else ""),
        "󰈉  Hide – process stays alive, YouTube keeps playing" + ("  ✓" if mode == "hide" else ""),
    ], "Select mode")
    if not new_mode: return
    apply_mode("relaunch" if "Relaunch" in new_mode else "hide", mode)


def apply_max(config, n):
    if n < 1:
        notify("ff5555", "  Invalid: value must be at least 1")
        return
    config["max_windows"] = n
    save_config(config)
    trim_history(n)
    trim_hidden(n)
    notify("50fa7b", f"  Max windows: {n}")


def menu_max(config):
    max_w = config.get("max_windows", 5)
    raw = input_text(f"Max windows in history (current: {max_w})")
    if not raw:
        return
    try:
        apply_max(config, int(raw))
    except ValueError:
        notify("ff5555", f"  Invalid: '{raw}' is not a number")


def apply_add_exclusion(config, app_id):
    excluded = config.get("excluded_classes", [])
    if app_id in excluded:
        notify("ff9900", f"  '{app_id}' is already excluded")
        return
    excluded.append(app_id)
    config["excluded_classes"] = excluded
    save_config(config)
    notify("ffb86c", f"  Excluded: {app_id}")


def apply_remove_exclusion(config, app_id):
    excluded = config.get("excluded_classes", [])
    if app_id not in excluded:
        return
    excluded.remove(app_id)
    config["excluded_classes"] = excluded
    save_config(config)
    notify("50fa7b", f"  Re-included: {app_id}")


def menu_exclusions(config):
    excluded = config.get("excluded_classes", [])

    action = pick([
        "  Enter app ID manually",
        "  Pick from open windows",
        f"  Remove entry  ({len(excluded)} in list)" if excluded else "  Remove entry  (list empty)",
    ], "Manage exclusion list")
    if not action: return

    if "manually" in action:
        app_id = input_text("Enter app class  (e.g. Alacritty, code, spotify)")
        if app_id: apply_add_exclusion(config, app_id)

    elif "open" in action:
        try:
            r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True)
            clients = json.loads(r.stdout)
            classes = sorted(set(
                c["class"] for c in clients
                if c.get("class") and c["class"] not in excluded
            ))
        except:
            classes = []
        if not classes:
            notify("ff9900", "  No new apps open")
            return
        selected = pick(classes, "Select app to exclude")
        if selected: apply_add_exclusion(config, selected)

    elif "Remove" in action:
        if not excluded:
            notify("ff9900", "  Exclusion list is empty")
            return
        selected = pick(excluded, "Select entry to remove")
        if selected: apply_remove_exclusion(config, selected)


def apply_notify(config, enabled):
    config["notifications_enabled"] = enabled
    save_config(config)
    if enabled:
        notify("50fa7b", "  Notifications: ON", config)


def menu_notify(config):
    enabled = config.get("notifications_enabled", True)
    new_val = pick([
        "  On – show notifications" + ("  ✓" if enabled else ""),
        "󰂛  Off – suppress all notifications" + ("  ✓" if not enabled else ""),
    ], "Notifications")
    if not new_val: return
    apply_notify(config, "On" in new_val)


def apply_pause(config, enabled):
    config["pause_on_close"] = enabled
    save_config(config)
    icon = "" if enabled else "󰝟"
    notify("50fa7b" if enabled else "ff9900", f"{icon}  Pause on close: {'ON' if enabled else 'OFF'}")


def menu_pause(config):
    pause = config.get("pause_on_close", True)
    new_val = pick([
        "  On – pause media when closing/hiding a window" + ("  ✓" if pause else ""),
        "  Off – never pause media automatically" + ("  ✓" if not pause else ""),
    ], "Pause media on close")
    if not new_val: return
    apply_pause(config, "On" in new_val)


def apply_workspace(config, n):
    ws = config.get("hide_workspace", 99)
    if n < 1:
        notify("ff5555", "  Invalid: workspace must be >= 1")
        return
    if n < 10:
        notify("ff9900", f"  Warning: workspace {n} may conflict with your normal workspaces!")
        return
    old_ws = ws
    config["hide_workspace"] = n
    save_config(config)
    # Migrate any currently hidden windows from old workspace to new one
    hidden = load_json(HIDDEN_FILE)
    if hidden and old_ws != n:
        for entry in hidden:
            addr = entry.get("address", "")
            if addr:
                subprocess.run(["hyprctl", "dispatch",
                                f"hl.dsp.window.move({{ workspace = '{n}', window = 'address:{addr}', follow = false }})"],
                                capture_output=True)
    notify("50fa7b", f"  Hide workspace: {n}")


def menu_ws(config):
    ws = config.get("hide_workspace", 99)
    raw = input_text(f"Hide workspace number (current: {ws}, recommended: >= 50)")
    if not raw: return
    try:
        apply_workspace(config, int(raw))
    except ValueError:
        notify("ff5555", f"  Invalid: '{raw}' is not a number")


def menu_bugreport(config):
    now = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M")
    downloads = os.path.expanduser("~/Downloads")
    os.makedirs(downloads, exist_ok=True)
    filepath = os.path.join(downloads, f"window-restore-bugreport-{now}.txt")

    # Package version
    try:
        r = subprocess.run(["pacman", "-Q", "omarchy-window-restore-git"],
                           capture_output=True, text=True)
        pkg_ver = r.stdout.strip() or "unknown"
    except:
        pkg_ver = "unknown"

    # Omarchy version
    try:
        r = subprocess.run(["omarchy-version"], capture_output=True, text=True)
        omarchy_ver = r.stdout.strip() or "unknown"
    except:
        omarchy_ver = "unknown"

    # Hyprland version (first line only)
    try:
        r = subprocess.run(["hyprctl", "version"], capture_output=True, text=True)
        first = r.stdout.splitlines()[0] if r.stdout else "unknown"
        # Extract just "Hyprland X.Y.Z" from the verbose line
        import re as _re
        m = _re.search(r"Hyprland\s+v?[\d.]+", first)
        hypr_ver = m.group(0) if m else first
    except:
        hypr_ver = "unknown"

    # History — only class names, no args/URLs
    history = load_json(HISTORY_FILE)
    history_classes = [e.get("class", "?") for e in history]

    # Hidden — only class names
    hidden = load_json(HIDDEN_FILE)
    hidden_classes = [e.get("class", "?") for e in hidden]

    # Active Window Restore keybindings
    try:
        r = subprocess.run(["hyprctl", "-j", "binds"], capture_output=True, text=True)
        binds = json.loads(r.stdout)
        wr_binds = [b for b in binds if any(
            kw in b.get("description", "") for kw in
            ["Restore", "Close window", "Pick window", "permanently", "Window Restore"]
        ) and "notification" not in b.get("description", "").lower()]
        MOD_MAP = {64: "SUPER", 65: "SUPER SHIFT", 68: "SUPER CTRL",
                   72: "SUPER ALT", 73: "SUPER SHIFT ALT"}
        bind_lines = [
            f"  {MOD_MAP.get(b['modmask'], str(b['modmask']))} + {b['key'].upper()}"
            f" → {b['description']}"
            for b in wr_binds
        ]
    except:
        bind_lines = ["  (could not read bindings)"]

    mode = get_mode()
    lines = [
        "omarchy-window-restore Bug Report",
        f"Generated: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M')}",
        "Issues: https://github.com/TimHerb2005/omarchy-window-restore/issues/new",
        "",
        "### Package",
        pkg_ver,
        "",
        "### System",
        f"Omarchy: {omarchy_ver}",
        f"Hyprland: {hypr_ver}",
        "",
        "### Config",
        f"max_windows:          {config.get('max_windows', '?')}",
        f"excluded_classes:     {config.get('excluded_classes', [])}",
        f"pause_on_close:       {config.get('pause_on_close', '?')}",
        f"notifications_enabled:{config.get('notifications_enabled', '?')}",
        f"hide_workspace:       {config.get('hide_workspace', '?')}",
        "",
        "### Mode",
        mode,
        "",
        f"### History ({len(history)} entries — app names only, no URLs or file paths)",
        *(([f"  - {c}" for c in history_classes]) if history_classes else ["  (empty)"]),
        "",
        f"### Hidden windows ({len(hidden)} entries)",
        *(([f"  - {c}" for c in hidden_classes]) if hidden_classes else ["  (empty)"]),
        "",
        "### Active Window Restore keybindings",
        *bind_lines,
        "",
        "---",
        "Note: This report contains no URLs, window titles, or personal data.",
    ]

    with open(filepath, "w") as f:
        f.write("\n".join(lines) + "\n")

    notify("50fa7b", f"🐛 Bug report saved to ~/Downloads/{os.path.basename(filepath)}")


def menu_settings(config):
    """Sub-menu with all configurable settings. Loops until ESC (goes back to main)."""
    while True:
        # Re-read config each iteration so values refresh after a change
        config = get_config()
        max_w   = config.get("max_windows", 5)
        excl    = config.get("excluded_classes", [])
        pause   = config.get("pause_on_close", True)
        hide_ws = config.get("hide_workspace", 99)
        notif   = config.get("notifications_enabled", True)

        menu = [
            f"  Max windows: {max_w}",
            f"  Exclusions: {len(excl)}",
            f"  Pause on close: {'On' if pause else 'Off'}",
            f"  Notifications: {'On' if notif else 'Off'}",
            f"  Hide workspace: {hide_ws}",
        ]

        selected = pick(menu, "Settings  (ESC → back)")
        if not selected: return  # ESC → back to main menu

        if "Max" in selected:
            menu_max(config)
        elif "Exclusions" in selected:
            menu_exclusions(config)
        elif "Pause" in selected:
            menu_pause(config)
        elif "Notifications" in selected:
            menu_notify(config)
        elif "workspace" in selected:
            menu_ws(config)


def main():
    while True:
        mode   = get_mode()
        config = get_config()

        mode_label = "Hide" if mode == "hide" else "Relaunch"
        mode_icon  = "󰈉" if mode == "hide" else "󰑓"

        menu = [
            f"{mode_icon}  Mode: {mode_label}",
            f"⚙  Settings",
            f"🐛  Create bug report",
        ]

        selected = pick(menu, "⚙ Window Restore Settings")
        if not selected: return  # ESC → close

        if "Mode" in selected:
            menu_mode(mode)
        elif "Settings" in selected:
            menu_settings(config)
        elif "bug report" in selected:
            menu_bugreport(config)


def cli_usage():
    print(
        "Usage: hypr-restore-settings [set-mode <relaunch|hide> | set-max <n> |\n"
        "  add-exclusion <class> | remove-exclusion <class> | set-pause <on|off> |\n"
        "  set-notify <on|off> | set-workspace <n> | bugreport]",
        file=sys.stderr,
    )
    sys.exit(1)


def cli_main(argv):
    """Direct, non-interactive actions for front ends with their own UI
    (currently the Window Restore Quickshell plugin)."""
    config = get_config()
    cmd, rest = argv[0], argv[1:]

    try:
        if cmd == "set-mode" and len(rest) == 1 and rest[0] in ("relaunch", "hide"):
            apply_mode(rest[0], get_mode())
        elif cmd == "set-max" and len(rest) == 1:
            apply_max(config, int(rest[0]))
        elif cmd == "add-exclusion" and len(rest) == 1:
            apply_add_exclusion(config, rest[0])
        elif cmd == "remove-exclusion" and len(rest) == 1:
            apply_remove_exclusion(config, rest[0])
        elif cmd == "set-pause" and len(rest) == 1 and rest[0] in ("on", "off"):
            apply_pause(config, rest[0] == "on")
        elif cmd == "set-notify" and len(rest) == 1 and rest[0] in ("on", "off"):
            apply_notify(config, rest[0] == "on")
        elif cmd == "set-workspace" and len(rest) == 1:
            apply_workspace(config, int(rest[0]))
        elif cmd == "bugreport" and len(rest) == 0:
            menu_bugreport(config)
        else:
            cli_usage()
    except ValueError:
        cli_usage()


if __name__ == "__main__":
    if len(sys.argv) > 1:
        cli_main(sys.argv[1:])
    else:
        main()
